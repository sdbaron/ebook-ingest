{
  "name": "@tagesberichte/ebook-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ebook-ingest": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"README.md\"",
    "setup:global": "node scripts/setup-global-ebook-ingest.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "chromadb": "^3.5.0",
    "epub": "^1.3.0",
    "ollama": "^0.5.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.23.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
